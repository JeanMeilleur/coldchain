// ColdChain — perishable inventory management
//
// Foundation adapted from the EdRoh fullstack inventory tutorial.
// This schema is a rewrite for cold-chain / perishable goods:
//   - stock is tracked in LOTS with expiration dates, not as a bare integer
//   - every quantity change is an immutable row in StockMovement (audit trail)
//   - storage locations carry temperature zones and readings (cold-chain compliance)
//   - the tutorial's pre-computed summary tables are GONE; the dashboard
//     aggregates live from the transaction ledger instead
//
// Money is Decimal(12,2), never Float. Binary floating point cannot
// represent 0.1 exactly, so summing thousands of float prices accumulates
// error -- you end up with 255262.20000000027 instead of 255262.20.
// Temperatures stay Float: they are physical measurements where a
// fractional degree of imprecision is meaningless.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Temperature class a product must be stored at.
enum StorageZone {
  FROZEN /// -18C or below
  REFRIGERATED /// 0C to 4C
  AMBIENT /// room temperature
}

/// Every row in the stock ledger is one of these.
enum MovementType {
  RECEIPT /// stock arriving from a supplier
  SALE /// stock leaving to a customer
  WASTE /// stock written off, never sold
  ADJUSTMENT /// manual correction after a physical count
  TRANSFER /// moved between storage locations
}

/// Why stock was written off. Drives the waste analytics.
enum WasteReason {
  EXPIRED
  DAMAGED
  TEMPERATURE_EXCURSION
  RECALL
  OTHER
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  userId       String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  movements StockMovement[]

  @@index([email])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Supplier {
  supplierId   String   @id @default(uuid())
  name         String
  contactEmail String?
  contactPhone String?
  /// Typical days between placing an order and receiving it.
  /// Used to decide when a low-stock product must be reordered.
  leadTimeDays Int      @default(3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  products Product[]
  lots     Lot[]
}

model Category {
  categoryId String @id @default(uuid())
  name       String @unique

  products Product[]
}

/// A physical place stock is kept. Cold zones are temperature-monitored.
model Location {
  locationId  String      @id @default(uuid())
  name        String      @unique
  zone        StorageZone
  /// Target temperature for this location, null for AMBIENT.
  targetTempC Float?
  /// How far from target is still acceptable before it counts as an excursion.
  toleranceC  Float       @default(2.0)
  isActive    Boolean     @default(true)

  lots     Lot[]
  readings TemperatureReading[]
}

/// The product definition. Note it has NO stockQuantity column --
/// on-hand quantity is derived by summing its lots.
model Product {
  productId     String      @id @default(uuid())
  sku           String      @unique
  name          String
  description   String?
  categoryId    String?
  supplierId    String?
  /// The unit stock is counted in: "case", "lb", "each".
  unit          String      @default("case")
  unitPrice     Decimal     @db.Decimal(12, 2)
  storageZone   StorageZone
  /// Days from receipt until expiry, used to date incoming lots.
  shelfLifeDays Int
  /// Reorder when on-hand drops to or below this.
  reorderPoint  Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  category Category? @relation(fields: [categoryId], references: [categoryId])
  supplier Supplier? @relation(fields: [supplierId], references: [supplierId])
  lots     Lot[]

  @@index([sku])
  @@index([categoryId])
  @@index([supplierId])
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

/// A single batch of a product received together, sharing one expiration date.
/// This is the heart of the perishables model: you never have "50 units of
/// chicken", you have three lots expiring on three different days.
model Lot {
  lotId             String   @id @default(uuid())
  /// Supplier's batch code, as printed on the case.
  lotCode           String
  productId         String
  supplierId        String?
  locationId        String?
  receivedAt        DateTime @default(now())
  expiresAt         DateTime
  quantityReceived  Int
  /// Denormalized running balance. Kept in sync with the movement ledger
  /// inside a transaction so queries stay fast without replaying history.
  quantityRemaining Int
  unitCost          Decimal  @db.Decimal(12, 2)
  /// Held back from sale, e.g. after a temperature excursion or recall.
  isQuarantined     Boolean  @default(false)

  product   Product         @relation(fields: [productId], references: [productId])
  supplier  Supplier?       @relation(fields: [supplierId], references: [supplierId])
  location  Location?       @relation(fields: [locationId], references: [locationId])
  movements StockMovement[]

  @@unique([productId, lotCode])
  @@index([expiresAt])
  /// Supports the core FIFO query: oldest-expiring lots of a product first.
  @@index([productId, expiresAt])
  @@index([locationId])
}

/// Immutable ledger. Every change in stock is one row here and rows are
/// never updated or deleted -- corrections are new ADJUSTMENT rows.
/// This is what makes the dashboard trustworthy and the history auditable.
model StockMovement {
  movementId  String       @id @default(uuid())
  lotId       String
  type        MovementType
  /// Positive for stock in, negative for stock out.
  quantity    Int
  /// Cost for inbound movements, sale price for outbound. Lets one table
  /// answer both "what did we spend" and "what did we earn".
  unitValue   Decimal      @db.Decimal(12, 2)
  wasteReason WasteReason?
  note        String?
  userId      String?
  occurredAt  DateTime     @default(now())

  lot  Lot   @relation(fields: [lotId], references: [lotId])
  user User? @relation(fields: [userId], references: [userId])

  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([lotId])
}

/// Cold-chain compliance log. A reading outside a location's tolerance
/// is an excursion, which can force stock in that location into quarantine.
model TemperatureReading {
  readingId   String   @id @default(uuid())
  locationId  String
  tempC       Float
  isExcursion Boolean  @default(false)
  recordedAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [locationId])

  @@index([locationId, recordedAt])
  @@index([isExcursion, recordedAt])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Expense {
  expenseId  String   @id @default(uuid())
  category   String
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  incurredAt DateTime @default(now())

  @@index([incurredAt])
  @@index([category, incurredAt])
}
